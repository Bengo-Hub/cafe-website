# Environment Configuration

# Service URLs
NEXT_PUBLIC_AUTH_SERVICE_URL=https://sso.codevertexitsolutions.com
NEXT_PUBLIC_ORDERING_SERVICE_URL=https://orderingapi.codevertexitsolutions.com
NEXT_PUBLIC_LOGISTICS_SERVICE_URL=https://logistics.codevertexitsolutions.com
NEXT_PUBLIC_TREASURY_SERVICE_URL=https://booksapi.codevertexitsolutions.com
NEXT_PUBLIC_BOOKING_SERVICE_URL=https://booking.codevertexitsolutions.com
NEXT_PUBLIC_NOTIFICATIONS_SERVICE_URL=https://notifications.codevertexitsolutions.com
# Feature Flags
NEXT_PUBLIC_USE_DUMMY_DATA=true
NEXT_PUBLIC_ENABLE_REAL_TIME_TRACKING=false
NEXT_PUBLIC_ENABLE_PAYMENTS=false

# Tenant Configuration
NEXT_PUBLIC_TENANT_SLUG=urban-loft
NEXT_PUBLIC_TENANT_ID=tenant-urban-loft

# Maps
NEXT_PUBLIC_MAP_PROVIDER=osm
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Analytics & Monitoring
# NEXT_PUBLIC_SENTRY_DSN=
# NEXT_PUBLIC_GA_TRACKING_ID=

# API Configuration
NEXT_PUBLIC_API_TIMEOUT=30000
NEXT_PUBLIC_API_RETRY_ATTEMPTS=3
